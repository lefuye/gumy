# ─── Gumy configuration ──────────────────────────────────────────────────────
# Copy this file, rename the copy to exactly:  .env
# then fill in the values. Never share your .env with anyone.

# REQUIRED - Discord bot token.
# Discord Developer Portal (https://discord.com/developers/applications)
# -> your application -> Bot -> Reset Token -> Copy.
TOKEN=paste-your-discord-bot-token-here

# REQUIRED - OpenAI API key (https://platform.openai.com/api-keys).
# This is what costs money - keep it private.
OPENAI_KEY=paste-your-openai-api-key-here

# OPTIONAL - channel(s) where Gumy replies to EVERY message without being
# @mentioned first. Comma-separated Discord channel IDs, e.g.
# HOME_CHANNEL_IDS=123456789012345678,234567890123456789
# How to get a channel ID: Discord settings -> Advanced -> enable Developer
# Mode, then right-click a channel -> Copy Channel ID.
# Leave unset and Gumy only replies when @mentioned.
HOME_CHANNEL_IDS=

# OPTIONAL - Discord user IDs and/or role IDs that skip ALL usage quotas
# (unlimited use, not tracked). Comma-separated. Leave unset for nobody.
# Right-click a user/role -> Copy User ID / Copy Role ID (Developer Mode).
QUOTA_WHITELIST_USERS=
QUOTA_WHITELIST_ROLES=

# REQUIRED for `node slashes.js` (slash command registration) only:
# Application ID: Discord Developer Portal -> your application ->
# General Information -> Application ID -> Copy.
BOT_ID=paste-your-application-id-here

# Server (guild) ID: right-click your server's name -> Copy Server ID
# (Developer Mode must be on).
GUILD_ID=paste-your-server-id-here
